# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# Never commit the .env.local file to git!

# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Your Supabase anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Public site URL — used to build OAuth & email-confirmation redirect URLs.
# Local dev falls back to http://localhost:3000; set this in production.
# NEXT_PUBLIC_SITE_URL=https://your-app.example.com

# n8n LLM Agent (optional) — used by app/api/chat to stream an agent to the UI.
# These stay server-side; never expose them to the browser.
# N8N_WEBHOOK_URL: your workflow's POST webhook (use the /webhook/ production URL;
#   the /webhook-test/ URL only fires while the n8n editor is "Listening").
# N8N_WEBHOOK_SECRET: the value sent as the `API_KEY` request header — set up a
#   matching n8n "Header Auth" credential (header name = API_KEY) on the webhook node.
# N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/your-agent
# N8N_WEBHOOK_SECRET=your_api_key_value

# Zep knowledge-graph memory (optional) — used by app/api/chat to retrieve the
# user's long-term context before calling n8n and to record each turn back to
# the user's graph. Server-side only; never exposed to the browser. The chat
# works normally when this is unset (the feature stays dormant).
# Get a key from https://app.getzep.com (Project Settings).
# ZEP_API_KEY=your_zep_api_key
